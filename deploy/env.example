# /srv/kanasante/<stage>/.env — written once by deploy/bootstrap.sh, then hand-edited.
# NEVER committed with real values. Only variables that differ from .env.schema
# defaults need to be here; varlock validates the rest at container start.
#
# Lines marked GENERATED are filled by bootstrap.sh with `openssl rand`.
# Lines marked FILL IN need a human before the API is useful.

# --- compose (read by docker compose, not the app) ---------------------------
COMPOSE_PROJECT_NAME=kanasante-__STAGE__
IMAGE=ghcr.io/kanasante/api
# IMAGE_TAG is overwritten by CI on every deploy; API_PORT is the 127.0.0.1 port nginx proxies to.
IMAGE_TAG=__IMAGE_TAG__
API_PORT=__API_PORT__
DB_USER=kanasante
DB_NAME=kanasante
DB_PASSWORD=__GENERATED__

# --- app --------------------------------------------------------------------
APP_ENV=__STAGE__
BETTER_AUTH_URL=https://__SERVER_NAME__
# The frontends that may call this API with cookies (comma-separated).
CORS_ORIGINS=https://kanasante.com,http://localhost:3000,http://localhost:8081
DEFAULT_LOCALE=fr

BETTER_AUTH_SECRET=__GENERATED__
DATA_ENCRYPTION_KEY=__GENERATED__
DATA_HMAC_KEY=__GENERATED__

# Email (Resend). FILL IN: a real API key; the from-address domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=KanaSanté <no-reply@kanasante.com>

# File storage (real S3, af-south-1). FILL IN: an IAM user scoped to this one bucket.
S3_BUCKET=kanasante-__STAGE__
S3_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Seed accounts for `docker compose run --rm migrate bunx varlock run -- bun scripts/seed.ts`
# are intentionally NOT set on deployed stages.
