meta {
  name: 2 · Capture the doctor's practitioner id
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/practitioners/me
  body: none
  auth: inherit
}

script:post-response {
  if (res.body && res.body.id) {
    bru.setVar("practitionerId", res.body.id);
  }
}

tests {
  test("a verified practitioner profile — its id is what the patient will book", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.be.a("string");
    expect(res.body.verificationStatus).to.equal("verified");
  });
}
