meta {
  name: 8 · The patient's upcoming appointments
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/me/appointments
  body: none
  auth: inherit
}

tests {
  test("the new booking is on the patient's list", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array");
    const ids = res.body.data.map(function (a) { return a.id; });
    expect(ids).to.include(bru.getVar("appointmentId"));
  });
}
