meta {
  name: 9 · Open the appointment
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/v1/appointments/:id
  body: none
  auth: inherit
}

params:path {
  id: {{appointmentId}}
}

tests {
  test("the confirmed appointment, as the booking screen shows it", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal(bru.getVar("appointmentId"));
    expect(res.body.status).to.equal("confirmed");
    expect(res.body.startsAt).to.equal(bru.getVar("slotStartsAt"));
    expect(res.body.slotKey).to.equal(bru.getVar("slotKey"));
  });
}
