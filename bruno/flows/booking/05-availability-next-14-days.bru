meta {
  name: 5 · Open slots over the next two weeks — take the first
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/practitioners/:id/availability?from={{availabilityFrom}}&to={{availabilityTo}}
  body: none
  auth: inherit
}

params:path {
  id: {{practitionerId}}
}

script:pre-request {
  const now = new Date();
  bru.setVar("availabilityFrom", now.toISOString());
  bru.setVar("availabilityTo", new Date(now.getTime() + 14 * 86400000).toISOString());
}

script:post-response {
  const first = res.body && res.body.data && res.body.data[0];
  if (first) {
    bru.setVar("slotKey", first.key);
    bru.setVar("slotStartsAt", first.startsAt);
    // JSON-encoded so the hold body can splice it in unquoted: a uuid string or null.
    bru.setVar("slotLocationIdJson", JSON.stringify(first.locationId));
  }
}

tests {
  test("the doctor has open slots — the first one is captured for the hold", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array").that.is.not.empty;
    expect(res.body.data[0].key).to.be.a("string");
    expect(res.body.data[0].startsAt).to.be.a("string");
    expect(res.body.data[0].consultationTypes).to.include("in_person");
  });
}

docs {
  Slots are expanded from the doctor's recurring Mon–Fri 09:00–17:00 (Douala) rules,
  minus anything already held or confirmed, and never in the past — so `data[0]` is
  always holdable. Each slot's `key` (`rule:<ruleId>:<isoStart>`) is the handle the
  booking API expects back.
}
