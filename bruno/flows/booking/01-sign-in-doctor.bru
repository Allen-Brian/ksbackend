meta {
  name: 1 · The doctor signs in (to learn her own id)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
  auth: none
}

headers {
  Origin: {{baseUrl}}
}

body:json {
  {
    "email": "{{demoDoctorEmail}}",
    "password": "{{demoDoctorPassword}}"
  }
}

script:post-response {
  const token = res.headers["set-auth-token"];
  if (token) {
    bru.setVar("token", token);
    bru.setVar("doctorToken", token);
  }
}

tests {
  test("signed in as the demo doctor — token captured automatically", function () {
    expect(res.status).to.equal(200);
    expect(res.headers["set-auth-token"]).to.be.a("string");
  });
}

docs {
  Booking story: a diaspora patient holds → confirms a consultation with the seeded
  Douala doctor, both sides look at it, then the patient cancels so the seed data is
  left exactly as it was. Zero variables to fill in; run the folder in sequence.

  We start on the doctor's side only to capture her practitioner profile id from
  `GET /v1/practitioners/me` — more robust than fishing it out of search results.
}
