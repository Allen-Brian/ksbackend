meta {
  name: 5 · Open the doctor's bookable profile
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/practitioners/:id
  body: none
  auth: inherit
}

params:path {
  id: {{practitionerId}}
}

tests {
  test("the full public profile the app's detail screen renders", function () {
    expect(res.status).to.equal(200);
    expect(res.body.surname).to.be.a("string");
  });
}
