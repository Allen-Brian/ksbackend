meta {
  name: 7 · The rating that powers the doctor's card
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/practitioners/:id/reviews/summary
  body: none
  auth: inherit
}

params:path {
  id: {{practitionerId}}
}

tests {
  test("aggregate rating + distribution", function () {
    expect(res.status).to.equal(200);
    expect(res.body.distribution).to.be.an("object");
  });
}
