meta {
  name: 3 · Search doctors in Douala, best-rated first
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/practitioners?city=Douala&sort=rating
  body: none
  auth: inherit
}

script:post-response {
  const first = res.body && res.body.data && res.body.data[0];
  if (first) {
    bru.setVar("practitionerId", first.id);
  }
}

tests {
  test("verified practitioners found — first result captured for the next steps", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array").that.is.not.empty;
  });
}
