meta {
  name: Update notification preferences for one or more categories
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/v1/me/notifications
  body: json
  auth: inherit
}

body:json {
  {
    "preferences": [
      {
        "category": "appointments",
        "email": true,
        "sms": false,
        "push": true
      }
    ]
  }
}
