# Copy to `.env.local` (git-ignored) and fill in ONLY what you need to override.
# Local dev works out of the box with the defaults in `.env.schema` — you usually
# don't need to set anything here for local development.
#
#   cp .env.local.example .env.local
#
# Uncomment + set as needed:

# PORT=3000
# DATABASE_URL=postgres://kanasante:kanasante@localhost:5432/kanasante
# If host port 5432 is taken: `DB_PORT=5433 docker compose up -d db` and then
# DATABASE_URL=postgres://kanasante:kanasante@localhost:5433/kanasante

# Only required when running with APP_ENV=prod. Generate: openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Optional — enables distributed cache + rate limiting. Omit to run without Redis.
# REDIS_URL=redis://localhost:6379
